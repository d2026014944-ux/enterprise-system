# ─────────────────────────────────────────────────────────────
# Environment Variables — Enterprise System
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Naming convention: UPPER_SNAKE_CASE
# All values are strings. Type conversion happens in app config.
# ─────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api/v1
API_VERSION=1.0.0

# ── Security ────────────────────────────────────────────────
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT configuration
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_REFRESH_EXPIRATION=7d

# Rate limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise?schema=public

# Connection pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=10000
DATABASE_POOL_CONNECTION_TIMEOUT=5000

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis connection pool
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ── Logging ─────────────────────────────────────────────────
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ── Observability ───────────────────────────────────────────
# Jaeger (distributed tracing)
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@enterprise.system
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@enterprise.system

# ── Shutdown ────────────────────────────────────────────────
# Graceful shutdown timeout (milliseconds)
SHUTDOWN_TIMEOUT_MS=10000

# ── External Services ───────────────────────────────────────
# Add any external API keys here
# EXTERNAL_API_KEY=change-me
# EXTERNAL_API_URL=https://api.example.com
